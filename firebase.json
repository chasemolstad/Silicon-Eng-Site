{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "archive/**"
    ],
    "redirects": [
      {
        "source": "/concept-4.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/concept-@(1|2).html",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/resources-1.html",
        "destination": "/resources-2.html",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.woff2",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(webp|avif|png|jpg|jpeg|svg|mp4|webm|pdf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "silicon-eng",
        "supportEmail": "support@silicon-eng.firebaseapp.com"
      }
    }
  }
}
