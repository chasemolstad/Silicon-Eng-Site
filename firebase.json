{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "concept-1.html",
      "concept-2.html",
      "concept-one.css",
      "concept-one.js",
      "concept-two.css",
      "concept-two.js",
      "resources-1.html",
      "resources-1.css",
      "services.js",
      "img/benchsetup1.png",
      "img/DomingoFigueroa.jpg",
      "img/HQSiliconEngCircle.png",
      "img/Iridescent Wafer Probe Testing Station.png",
      "img/Precision Microchip Probe Testing.png",
      "img/RajMoothedath.jpg",
      "img/Semiconductor Test Chamber and Circuit Boards.png",
      "img/service-hardware.jpg",
      "img/service-qualification.jpg",
      "img/SiliconEngCircle.png",
      "img/siliconengvideo2-poster.jpg",
      "img/thermostream-2.png",
      "img/TransparentSiliconEngCircle.png",
      "img/uf200-2.png",
      "img/Verticalprobe.png",
      "img/video-poster.jpg",
      "img/video.mp4",
      "img/wafer-probe-wide.jpg",
      "img/automated-test-lab.avif",
      "img/evalboardtest.jpg",
      "img/traystack.jpg",
      "img/hero-reel-source.mp4",
      "img/download (2).mp4",
      "img/hero-reel-source-2k.mp4",
      "img/hero-reel.mp4",
      "img/hero-reel-poster.webp",
      "img/siliconengvideo2.mp4",
      "img/siliconengvideo2-poster.webp"
    ],
    "redirects": [
      {
        "source": "/concept-4.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/concept-@(1|2).html",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/resources-1.html",
        "destination": "/resources-2.html",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.woff2",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(webp|avif|png|jpg|jpeg|svg|mp4|webm|pdf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "silicon-eng",
        "supportEmail": "support@silicon-eng.firebaseapp.com"
      }
    }
  }
}
